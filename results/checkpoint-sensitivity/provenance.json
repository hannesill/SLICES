    "device": "cpu",
    "drop_last": true,
    "dropout": 0.0,
    "embedding_batch_size": 256,
    "encoding_threads": 2,
    "epochs": 50,
    "eta_min": 1e-06,
    "freeze_encoder": true,
    "gradient_clip": 1.0,
    "head": "linear",
    "head_seed": "training seed, reset before each task/version",
    "hidden_dims": [],
    "label_fraction": 1.0,
    "label_smoothing": 0.1,
    "lr": 0.0001,
    "name": "linear_probe_cached_embeddings",
    "normalization": "full unfiltered training cohort; observed mean/sample std; then zero-fill",
    "optimizer": "adamw",
    "patience": 10,
    "pooling": "mean over observed timesteps",
    "probe_threads": 1,
    "regression_report": "mean_absolute_error_days",
    "regression_select": "mean_absolute_error",
    "regression_train": "mean_squared_error",
    "scheduler": "cosine",
    "selection": "strict validation improvement, earliest epoch on ties; test once afterward",
    "split": "canonical sorted patient shuffle, 70/15/15; filter labels after assignment",
    "test_used_for_selection": false,
    "weight_decay": 0.05
  },
